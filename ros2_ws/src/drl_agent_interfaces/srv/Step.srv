float32[] action    # Action to take, [v, w]

---
float32[] state     # Next state as a result of the action taken
float32 reward      # Reward feedback
bool done           # Flag to indicate if the episode is done
bool target         # Flag to indicate if goal is reached
bool collision           # True collision flag from the FULL-360 environment_state
                          # (the same quantity check_collision() uses) -- unlike
                          # state[:environment_dim] (the front-180 obs_state RL
                          # input), this is never confusable with the front-only scan.
float32 min_obstacle_dist_m  # FULL-360 environment_state min distance this step
                          # (== check_collision()'s min_used); lets a caller apply
                          # its OWN near-collision threshold without re-deriving it
                          # from the (front-only) RL state.

